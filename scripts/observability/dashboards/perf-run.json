{
  "uid": "cost-onprem-perf-run",
  "title": "Cost On-Prem: Performance Run",
  "description": "Per-run view using standard Kubernetes container metrics (no custom exporters required)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "tags": ["perf", "cost-onprem"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "refresh": 1,
        "current": {
          "text": "Prometheus",
          "value": "bfmqrmxf2fgn4a"
        }
      },
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "hide": 0,
        "current": { "text": "cost-onprem", "value": "cost-onprem" },
        "options": [{ "text": "cost-onprem", "value": "cost-onprem" }],
        "query": "cost-onprem"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "## Cost On-Prem Performance Run\nShows CPU, memory, and network for the `$namespace` namespace during the test window. All panels use standard Kubernetes container metrics — no custom exporters required.",
        "mode": "markdown"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU Usage by Pod (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1.5, "fillOpacity": 5 } }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory Working Set by Pod (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 1.5, "fillOpacity": 5 } }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by(pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Listener CPU (cores) — koku-listener",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*koku-listener.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "listener CPU",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Celery Worker CPU (cores) — all workers",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*celery-worker.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "celery workers CPU",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Network Receive Rate (bytes/s) — ingress pod",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=~\".*ingress.*\"}[5m]))",
          "legendFormat": "ingress receive",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Peak Listener CPU",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time(sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*koku-listener.*\", container!=\"\"}[5m]))[6h:1m])",
          "legendFormat": "cores",
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Peak Celery Worker CPU",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 4.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time(sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*celery-worker.*\", container!=\"\"}[5m]))[6h:1m])",
          "legendFormat": "cores",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Peak DB Memory",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time(sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\".*database.*\", container!=\"\"})[6h:1m])",
          "legendFormat": "bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Peak Total CPU (namespace)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time(sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))[6h:1m])",
          "legendFormat": "cores",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Peak Total Memory (namespace)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8589934592 },
              { "color": "red", "value": 16106127360 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time(sum(container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"})[6h:1m])",
          "legendFormat": "bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 35,
      "type": "stat",
      "title": "CPU Throttling % (celery workers)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", pod=~\".*celery-worker.*\"}[5m])) / sum(rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", pod=~\".*celery-worker.*\"}[5m]))",
          "legendFormat": "throttle %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Network: Ingress Receive + Transmit",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "lineWidth": 1.5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=~\".*ingress.*\"}[5m]))",
          "legendFormat": "receive",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\", pod=~\".*ingress.*\"}[5m]))",
          "legendFormat": "transmit",
          "refId": "B"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "CPU Throttling by Worker Type",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 1.5 }, "min": 0, "max": 1 }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by(pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", pod=~\".*celery.*\", container!=\"\"}[5m])) / sum by(pod) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", pod=~\".*celery.*\", container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
