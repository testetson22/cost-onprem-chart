{
  "uid": "cost-onprem-minio-runs",
  "title": "Cost On-Prem: Historical Perf Runs (MinIO)",
  "description": "Reads perf-summary.json files from the MinIO/S3 bucket. Requires the Infinity datasource plugin (yesoreyeram-infinity-datasource) configured with MinIO credentials. No live cluster needed.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": { "from": "now-90d", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "tags": ["perf", "cost-onprem", "minio", "historical"],
  "templating": {
    "list": [
      {
        "name": "infinity",
        "type": "datasource",
        "pluginId": "yesoreyeram-infinity-datasource",
        "label": "Infinity",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "minio_base",
        "type": "constant",
        "label": "MinIO Base URL",
        "hide": 2,
        "current": {
          "text": "https://minio-s3-ecosystem-qe-ai--pipeline.apps.gpc.ocp-hub.prod.psi.redhat.com",
          "value": "https://minio-s3-ecosystem-qe-ai--pipeline.apps.gpc.ocp-hub.prod.psi.redhat.com"
        },
        "query": "https://minio-s3-ecosystem-qe-ai--pipeline.apps.gpc.ocp-hub.prod.psi.redhat.com"
      },
      {
        "name": "bucket",
        "type": "constant",
        "label": "Bucket",
        "hide": 2,
        "current": { "text": "eco-bucket-perf-scale", "value": "eco-bucket-perf-scale" },
        "query": "eco-bucket-perf-scale"
      },
      {
        "name": "prefix",
        "type": "constant",
        "label": "S3 Prefix",
        "hide": 2,
        "current": { "text": "cost-onprem-performance", "value": "cost-onprem-performance" },
        "query": "cost-onprem-performance"
      },
      {
        "name": "run_id",
        "type": "query",
        "label": "Run",
        "hide": 0,
        "refresh": 2,
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
        "definition": "",
        "query": {
          "type": "json",
          "parser": "uql",
          "url": "${minio_base}/${bucket}/${prefix}/index.json",
          "uql": "parse-json | project \"runs\" | mv-expand \"runs\" | project \"run_id\"=runs[\"run_id\"]",
          "source": "url"
        },
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "profile",
        "type": "custom",
        "label": "Profile",
        "hide": 0,
        "options": [
          { "text": "All",      "value": "$__all" },
          { "text": "baseline", "value": "baseline" },
          { "text": "small",    "value": "small" },
          { "text": "medium",   "value": "medium" },
          { "text": "large",    "value": "large" }
        ],
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "## Cost On-Prem: Historical Performance Runs\nData sourced from `${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json`.\nRequires [Infinity datasource](https://grafana.com/grafana/plugins/yesoreyeram-infinity-datasource/) configured with MinIO credentials.\n\n> Select a **Run** above to view its results. Use **Profile** to filter the test table.",
        "mode": "markdown"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Tests Passed",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":0.8},{"color":"red","value":0.6}] },
          "unit": "none", "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"passed\"=run[\"passed\"], \"total\"=run[\"total_tests\"] | extend \"pass_rate\"=passed/total"
      }]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Failed",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":3}] },
          "unit": "none", "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"failed\"=run[\"failed\"]"
      }]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Duration",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": { "defaults": { "unit": "m" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"duration_min\"=run[\"duration_min\"]"
      }]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Chart Version",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"chart_version\"=run[\"chart_version\"]"
      }]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Profile",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"profile\"=run[\"profile\"]"
      }]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "KPI Status",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 3 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":3}] },
          "unit": "none", "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"run\" | project \"kpi_violations\"=run[\"kpi_violations\"]"
      }]
    },
    {
      "id": 20,
      "type": "table",
      "title": "All Test Results",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                {"type":"value","options":{"PASS":{"color":"green","index":0},"FAIL":{"color":"red","index":1}}}
              ]}
            ]
          },
          {"matcher":{"id":"byName","options":"passed"},"properties":[{"id":"custom.hidden","value":true}]},
          {"matcher":{"id":"byName","options":"run_id"},"properties":[{"id":"custom.hidden","value":true}]},
          {"matcher":{"id":"byName","options":"test_name"},"properties":[{"id":"custom.hidden","value":true}]},
          {"matcher":{"id":"byName","options":"timestamp"},"properties":[{"id":"custom.hidden","value":true}]},
          {"matcher":{"id":"byName","options":"chart_version"},"properties":[{"id":"custom.hidden","value":true}]},
          {"matcher":{"id":"byName","options":"kpi_status"},"properties":[
            {"id":"custom.displayMode","value":"color-background"},
            {"id":"mappings","value":[
              {"type":"value","options":{
                "green":{"color":"green","index":0,"text":"OK"},
                "yellow":{"color":"yellow","index":1,"text":"WARN"},
                "red":{"color":"red","index":2,"text":"FAIL"}
              }}
            ]}
          ]}
        ]
      },
      "options": { "sortBy": [{"desc":false,"displayName":"short_name"}], "frameIndex": 0 },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"tests\" | mv-expand \"tests\" | project \"short_name\"=tests[\"short_name\"], \"status\"=tests[\"status\"], \"kpi_status\"=tests[\"kpi_status\"], \"duration_s\"=tests[\"duration_s\"], \"upload_mb_s\"=tests[\"upload_throughput_mb_s\"], \"api_p95_ms\"=tests[\"api_p95_ms\"], \"listener_cpu\"=tests[\"listener_cpu_cores\"], \"error\"=tests[\"error\"]"
      }]
    },
    {
      "id": 30,
      "type": "barchart",
      "title": "Test Durations (seconds)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "xField": "short_name",
        "orientation": "horizontal",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"tests\" | mv-expand \"tests\" | project \"short_name\"=tests[\"short_name\"], \"Duration (s)\"=tests[\"duration_s\"]"
      }]
    },
    {
      "id": 40,
      "type": "table",
      "title": "API Latency (p50 / p95 / p99 ms)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          {"matcher":{"id":"byName","options":"endpoint"},"properties":[{"id":"unit","value":"string"}]},
          {"matcher":{"id":"byName","options":"test"},"properties":[{"id":"unit","value":"string"}]},
          {"matcher":{"id":"byName","options":"p95_ms"},"properties":[
            {"id":"custom.displayMode","value":"color-background-solid"},
            {"id":"thresholds","value":{"mode":"absolute","steps":[
              {"color":"green","value":null},
              {"color":"yellow","value":2000},
              {"color":"red","value":5000}
            ]}}
          ]},
          {"matcher":{"id":"byName","options":"p99_ms"},"properties":[
            {"id":"custom.displayMode","value":"color-background-solid"},
            {"id":"thresholds","value":{"mode":"absolute","steps":[
              {"color":"green","value":null},
              {"color":"yellow","value":3000},
              {"color":"red","value":8000}
            ]}}
          ]}
        ]
      },
      "options": { "sortBy": [{"desc":true,"displayName":"p95_ms"}], "frameIndex": 0 },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"api\" | mv-expand \"api\" | project \"test\"=api[\"test\"], \"endpoint\"=api[\"endpoint\"], \"iterations\"=api[\"iterations\"], \"p50_ms\"=api[\"p50_ms\"], \"p95_ms\"=api[\"p95_ms\"], \"p99_ms\"=api[\"p99_ms\"], \"success_rate\"=api[\"success_rate\"]"
      }]
    },
    {
      "id": 41,
      "type": "table",
      "title": "Ingestion Performance",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher":{"id":"byName","options":"test"},"properties":[{"id":"unit","value":"string"}]},
          {"matcher":{"id":"byName","options":"upload_speed_mb_s"},"properties":[{"id":"unit","value":"MBs"},{"id":"displayName","value":"Upload MB/s"}]},
          {"matcher":{"id":"byName","options":"upload_size_mb"},"properties":[{"id":"unit","value":"megabytes"}]},
          {"matcher":{"id":"byName","options":"processing_time_min"},"properties":[{"id":"unit","value":"m"}]},
          {"matcher":{"id":"byName","options":"listener_cpu_cores"},"properties":[{"id":"unit","value":"short"},{"id":"displayName","value":"Listener CPU"}]},
          {"matcher":{"id":"byName","options":"passed"},"properties":[
            {"id":"custom.displayMode","value":"color-background"},
            {"id":"mappings","value":[{"type":"value","options":{"1":{"color":"green","index":0,"text":"PASS"},"0":{"color":"red","index":1,"text":"FAIL"}}}]}
          ]}
        ]
      },
      "options": { "sortBy": [], "frameIndex": 0 },
      "targets": [{
        "refId": "A",
        "type": "json", "parser": "uql", "source": "url",
        "url": "${minio_base}/${bucket}/${prefix}/${run_id}/results/perf-summary.json",
        "uql": "parse-json | project \"ingestion\" | mv-expand \"ingestion\" | project \"test\"=ingestion[\"test\"], \"passed\"=ingestion[\"passed\"], \"upload_size_mb\"=ingestion[\"upload_size_mb\"], \"upload_speed_mb_s\"=ingestion[\"upload_speed_mb_s\"], \"processing_time_min\"=ingestion[\"processing_time_min\"], \"listener_cpu_cores\"=ingestion[\"listener_cpu_cores\"]"
      }]
    }
  ]
}
