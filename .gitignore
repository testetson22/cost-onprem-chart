tests/fauxfactory/
tests/pandas/
tests/iqe/
tests/iqe_cost_management/
tests/iqe_cost_management_api/

# Note: tests/iqe_adapter/ is NOT ignored - it's our core adapter code

# Virtual environments
venv/
env/
ENV/
.venv/
cost-mgmt-venv/
*-venv/

# PR triage reports (ephemeral analysis files)
PR*-TRIAGE-*.md
PR*-QUICK-SUMMARY.md
PR*-COMMENTS-*.md

# PR summary documents (maintained during development)
PR-SUMMARY-*.md

# Test logs
test-logs/
*.log

# CI artifacts (downloaded from Prow/GCS)
ci-artifacts-*/

# Temporary files
*.tmp
*.temp
*.swp
*~
.DS_Store
*.csv
version_info.json
.digest-cache/*.digest
reports/junit.xml
